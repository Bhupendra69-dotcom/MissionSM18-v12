<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="top"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:paddingTop="9dp"
    android:paddingBottom="17dp"
    android:background="@drawable/widget_background">

    <TextView
        android:id="@+id/widget_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Mission SM18"
        android:textColor="#FF000000"
        android:textSize="15sp"
        android:textStyle="bold"
        android:maxLines="1" />

    <TextView
        android:id="@+id/widget_date"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:text="4y   11mo   28d"
        android:textColor="#FF000000"
        android:textSize="20sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end" />

    <LinearLayout
        android:id="@+id/widget_time_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="06h   51m   46s"
            android:textColor="#FF000000"
            android:textSize="15sp"
            android:includeFontPadding="false"
            android:maxLines="1" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_main_progress_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="8dp"
            android:layout_weight="1">
            <ProgressBar android:id="@+id/widget_progress_green" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="8dp" android:max="1000" android:progress="1000" android:progressTint="#2E7D32" android:progressBackgroundTint="#559E9E9E" />
            <ProgressBar android:id="@+id/widget_progress_yellow" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="8dp" android:max="1000" android:progress="1000" android:progressTint="#F9A825" android:progressBackgroundTint="#559E9E9E" android:visibility="gone" />
            <ProgressBar android:id="@+id/widget_progress_orange" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="8dp" android:max="1000" android:progress="1000" android:progressTint="#EF6C00" android:progressBackgroundTint="#559E9E9E" android:visibility="gone" />
            <ProgressBar android:id="@+id/widget_progress_red" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="8dp" android:max="1000" android:progress="1000" android:progressTint="#C62828" android:progressBackgroundTint="#559E9E9E" android:visibility="gone" />
        </FrameLayout>
        <TextView
            android:id="@+id/widget_main_percent"
            android:layout_width="42dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="7dp"
            android:gravity="end|center_vertical"
            android:text="100%"
            android:textColor="#FF000000"
            android:textSize="12sp"
            android:textStyle="bold"
            android:maxLines="1" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical" />

    <LinearLayout
        android:id="@+id/widget_bottom_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="0dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/widget_today"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2.0"
            android:layout_marginEnd="8dp"
            android:text="Friday, 16 Oct 2026"
            android:textColor="#FF000000"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:ellipsize="end" />
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="6dp"
            android:layout_weight="0.65"
            android:contentDescription="Time remaining today">
            <ProgressBar android:id="@+id/widget_day_track" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="6dp" android:max="1000" android:progress="1000" android:progressTint="#559E9E9E" android:progressBackgroundTint="#559E9E9E" />
            <ProgressBar android:id="@+id/widget_day_green" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="6dp" android:max="1000" android:progress="1000" android:progressTint="#2E7D32" android:progressBackgroundTint="#559E9E9E" />
            <ProgressBar android:id="@+id/widget_day_yellow" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="6dp" android:max="1000" android:progress="1000" android:progressTint="#F9A825" android:progressBackgroundTint="#559E9E9E" android:visibility="gone" />
            <ProgressBar android:id="@+id/widget_day_orange" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="6dp" android:max="1000" android:progress="1000" android:progressTint="#EF6C00" android:progressBackgroundTint="#559E9E9E" android:visibility="gone" />
            <ProgressBar android:id="@+id/widget_day_red" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="6dp" android:max="1000" android:progress="1000" android:progressTint="#C62828" android:progressBackgroundTint="#559E9E9E" android:visibility="gone" />
        </FrameLayout>
        <TextView
            android:id="@+id/widget_day_percent"
            android:layout_width="38dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:gravity="end|center_vertical"
            android:text="52%"
            android:textColor="#FF000000"
            android:textSize="12sp"
            android:textStyle="bold"
            android:maxLines="1" />
    </LinearLayout>
</LinearLayout>
